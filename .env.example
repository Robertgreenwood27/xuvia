# Existing checkout settings (server-only except the publishable key).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Enable only after xuvia.co is verified in Resend and replies reach your inbox.
# Scope a dedicated Resend API key to sending for xuvia.co.
RESEND_API_KEY=
ORDER_EMAIL_FROM=Robert at Xuvia <hello@xuvia.co>
ORDER_EMAIL_REPLY_TO=hello@xuvia.co
ORDER_EMAIL_ENABLED=false
# Set to the UTC instant of launch, e.g. 2026-11-20T18:00:00Z.
# Payments created before this instant do not receive a confirmation email.
ORDER_EMAIL_START_AT=
